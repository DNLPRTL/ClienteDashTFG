+def _como_booleano(valor: object, por_defecto: bool) -> bool:
+    if isinstance(valor, bool):
+        return valor
+    if isinstance(valor, str):
+        texto = valor.strip().lower()
+        if texto in {"true", "yes", "1", "on"}:
+            return True
+        if texto in {"false", "no", "0", "off"}:
+            return False
+    return bool(por_defecto)
+
+
+def _flotante_positivo(valor: object, por_defecto: float) -> float:
+    convertido = _flotante_finito(valor)
+    if convertido is None or convertido <= 0.0:
+        return float(por_defecto)
+    return float(convertido)
+
+
+def _tasas_desde_realimentacion(feedback: Mapping[str, object]) -> tuple[float, ...]:
+    tasas_brutas = feedback.get("tasas", ())
+    if isinstance(tasas_brutas, (str, bytes)):
+        return ()
+    try:
+        valores = tuple(tasas_brutas)
+    except TypeError:
+        return ()
+    tasas = []
+    for valor in valores:
+        convertido = _flotante_finito(valor)
+        if convertido is None or convertido <= 0.0:
+            return ()
+        tasas.append(float(convertido))
+    return tuple(tasas)
+
+
+def _menor_tasa_valida(carga) -> tuple[int | None, float]:
+    if carga is None:
+        return None, 0.0
+    for indice, valida in enumerate(carga.mascara_acciones):
+        if valida:
+            return int(indice), float(carga.tasas_Bps[indice])
+    return None, 0.0
+
