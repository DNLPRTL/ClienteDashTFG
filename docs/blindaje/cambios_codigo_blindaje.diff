@@ -0,0 +1,228 @@
+from __future__ import annotations
+
+import math
+import random
+from collections import defaultdict
+from typing import Any, Dict, List, Mapping, Optional, Sequence
+
+# Contrastes prerregistrados de la evaluacion final (fase de blindaje). La unidad de analisis es el
+# escenario (ventana x video) y el bloque es la ventana: las dos sesiones de una ventana comparten
+# red, asi que los intervalos remuestrean ventanas (bootstrap por bloques) y la prueba del signo usa
+# la diferencia media de cada ventana. Las hipotesis principales llevan correccion de Holm.
+
+VERSION_HIPOTESIS = "hipotesis_blindaje_v1"
+MARGEN_EQUIVALENCIA_QOE = 0.15  # 1 s de rebuffering en una sesion de 29 segmentos: 4,3 / 29
+REFERENCIA = "controlador_propio"
+REMUESTREOS_BOOTSTRAP = 10000
+SEMILLA_BOOTSTRAP = 2026
+
+HIPOTESIS_PRINCIPALES = (
+    {"id": "P1", "rival": "mpc_robusto", "metrica": "qoe_lineal_media", "tipo": "equivalencia",
+     "texto": "QoE equivalente a la del MPC robusto (margen +-0,15)"},
+    {"id": "P2", "rival": "mpc_robusto", "metrica": "num_stalls", "tipo": "menor",
+     "texto": "menos paradas por sesion que el MPC robusto"},
+    {"id": "P3", "rival": "propio_cuantiles_recientes", "metrica": "num_stalls", "tipo": "menor",
+     "texto": "menos paradas que la variante sin red con cuantiles de las ultimas descargas"},
+    {"id": "P4", "rival": "propio_cuantiles_fijos", "metrica": "qoe_lineal_media", "tipo": "mayor",
+     "texto": "mas QoE que la variante sin red con cuantiles fijos"},
+    {"id": "P5", "rival": "propio_mediana", "metrica": "num_stalls", "tipo": "menor",
+     "texto": "menos paradas que la variante sin CVaR (solo la mediana)"},
+)
+METRICAS_SECUNDARIAS = (
+    "qoe_lineal_media",
+    "num_stalls",
+    "rebuffering_total_s",
+    "bitrate_medio_kbps",
+    "num_cambios_calidad",
+    "qoe_log_media",
+)
+
+
+def definicion_hipotesis() -> Dict[str, Any]:
+    # Se copia al protocolo del paquete al planificar, antes de ejecutar ninguna sesion.
+    return {
+        "version": VERSION_HIPOTESIS,
+        "referencia": REFERENCIA,
+        "margen_equivalencia_qoe": MARGEN_EQUIVALENCIA_QOE,
+        "alfa": 0.05,
+        "principales": [dict(h) for h in HIPOTESIS_PRINCIPALES],
+        "metricas_secundarias": list(METRICAS_SECUNDARIAS),
+        "unidad": "escenario (ventana x video); bloque: ventana",
+        "intervalos": "bootstrap por ventanas, {0} remuestreos, semilla {1}".format(REMUESTREOS_BOOTSTRAP, SEMILLA_BOOTSTRAP),
+        "pruebas": "signo exacta sobre las diferencias medias por ventana (unilateral en 'menor'/'mayor'); "
+        "equivalencia por TOST: IC90 dentro de +-margen y p = max de los dos unilaterales (aprox. normal)",
+        "multiplicidad": "Holm sobre las hipotesis principales",
+    }
+
+
+def diferencias_por_ventana(
+    resumenes: Sequence[Mapping[str, Any]], a: str, b: str, metrica: str, filtro=None
+) -> Dict[str, List[float]]:
+    # Diferencia a - b en cada escenario con los dos controladores, agrupada por ventana.
+    por_escenario: Dict[tuple, Dict[str, float]] = defaultdict(dict)
+    for fila in resumenes:
+        if _bool(fila.get("sintetica")) or not _int(fila.get("evaluables")):
+            continue
+        if filtro is not None and not filtro(fila):
+            continue
+        clave = (str(fila.get("id_ventana_traza")), str(fila.get("id_perfil_video")), str(fila.get("repeticion")))
+        por_escenario[clave][str(fila.get("alias_controlador"))] = _float(fila.get(metrica))
+    por_ventana: Dict[str, List[float]] = defaultdict(list)
+    for (ventana, _video, _rep), valores in por_escenario.items():
+        if a in valores and b in valores:
+            por_ventana[ventana].append(valores[a] - valores[b])
+    return dict(por_ventana)
+
+
+def bootstrap_por_ventanas(por_ventana: Mapping[str, Sequence[float]], semilla: int = SEMILLA_BOOTSTRAP) -> List[float]:
+    rng = random.Random(semilla)
+    ventanas = sorted(por_ventana)
+    medias = []
+    for _ in range(REMUESTREOS_BOOTSTRAP):
+        suma, cuenta = 0.0, 0
+        for _ in ventanas:
+            valores = por_ventana[ventanas[rng.randrange(len(ventanas))]]
+            suma += sum(valores)
+            cuenta += len(valores)
+        medias.append(suma / cuenta)
+    medias.sort()
+    return medias
+
+
+def contraste(por_ventana: Mapping[str, Sequence[float]], tipo: str, margen: float = MARGEN_EQUIVALENCIA_QOE) -> Dict[str, Any]:
+    valores = [v for grupo in por_ventana.values() for v in grupo]
+    if not valores:
+        return {"n_escenarios": 0, "n_ventanas": 0}
+    medias_ventana = [sum(g) / len(g) for g in por_ventana.values()]
+    media = sum(valores) / len(valores)
+    boot = bootstrap_por_ventanas(por_ventana)
+    n = len(boot)
+    resultado: Dict[str, Any] = {
+        "n_escenarios": len(valores),
+        "n_ventanas": len(por_ventana),
+        "media_diferencia": media,
+        "ic95": [boot[int(0.025 * n)], boot[int(0.975 * n) - 1]],
+        "ic90": [boot[int(0.05 * n)], boot[int(0.95 * n) - 1]],
+        "ventanas_positivas": sum(1 for m in medias_ventana if m > 1e-12),
+        "ventanas_negativas": sum(1 for m in medias_ventana if m < -1e-12),
+        "ventanas_empate": sum(1 for m in medias_ventana if abs(m) <= 1e-12),
+        "escenarios_empate": sum(1 for v in valores if abs(v) <= 1e-12),
+    }
+    positivas, negativas = resultado["ventanas_positivas"], resultado["ventanas_negativas"]
+    if tipo == "menor":
+        resultado["p_valor"] = _cola_binomial(positivas + negativas, positivas)  # pocas ventanas con mas en el propio
+    elif tipo == "mayor":
+        resultado["p_valor"] = _cola_binomial(positivas + negativas, negativas)
+    elif tipo == "equivalencia":
+        if len(medias_ventana) > 1:
+            de = math.sqrt(sum((m - sum(medias_ventana) / len(medias_ventana)) ** 2 for m in medias_ventana)
+                           / (len(medias_ventana) - 1))
+            ee = de / math.sqrt(len(medias_ventana)) if de > 0 else 1e-12
+            centro = sum(medias_ventana) / len(medias_ventana)
+            p_inferior = 1.0 - _normal((centro + margen) / ee)
+            p_superior = _normal((centro - margen) / ee)
+            resultado["p_valor"] = max(p_inferior, p_superior)
+        else:
+            resultado["p_valor"] = 1.0
+        resultado["margen"] = margen
+        resultado["equivalente_ic90"] = bool(-margen < resultado["ic90"][0] and resultado["ic90"][1] < margen)
+    else:
+        resultado["p_valor_bilateral"] = min(1.0, 2.0 * _cola_binomial(positivas + negativas, min(positivas, negativas)))
+    return resultado
+
+
+def holm(p_valores: Mapping[str, float], alfa: float = 0.05) -> Dict[str, Dict[str, Any]]:
+    ordenados = sorted(p_valores.items(), key=lambda kv: kv[1])
+    m = len(ordenados)
+    salida, rechazando, maximo = {}, True, 0.0
+    for i, (clave, p) in enumerate(ordenados):
+        ajustado = min(1.0, max(maximo, (m - i) * p))
+        maximo = ajustado
+        rechazando = rechazando and p <= alfa / (m - i)
+        salida[clave] = {"p": p, "p_holm": ajustado, "rechazada_nula": bool(rechazando)}
+    return salida
+
+
+def contrastes_prerregistrados(
+    resumenes: Sequence[Mapping[str, Any]], hipotesis: Optional[Mapping[str, Any]] = None
+) -> Dict[str, Any]:
+    hipotesis = dict(hipotesis or definicion_hipotesis())
+    referencia = str(hipotesis.get("referencia", REFERENCIA))
+    margen = float(hipotesis.get("margen_equivalencia_qoe", MARGEN_EQUIVALENCIA_QOE))
+    alias = sorted({str(f.get("alias_controlador")) for f in resumenes if not _bool(f.get("sintetica"))})
+    principales = {}
+    for h in hipotesis.get("principales", []):
+        if h["rival"] not in alias or referencia not in alias:
+            continue
+        por_ventana = diferencias_por_ventana(resumenes, referencia, h["rival"], h["metrica"])
+        principales[h["id"]] = dict(h, **contraste(por_ventana, h["tipo"], margen))
+    ajuste = holm({k: v["p_valor"] for k, v in principales.items()}, float(hipotesis.get("alfa", 0.05)))
+    for clave, valores in ajuste.items():
+        principales[clave].update(valores)
+
+    secundarias: Dict[str, Dict[str, Any]] = {}
+    for rival in alias:
+        if rival == referencia:
+            continue
+        secundarias[rival] = {
+            metrica: contraste(diferencias_por_ventana(resumenes, referencia, rival, metrica), "bilateral")
+            for metrica in hipotesis.get("metricas_secundarias", METRICAS_SECUNDARIAS)
+        }
+    estratos = {}
+    for nombre, filtro in (
+        ("video_nuevo", lambda f: "tears" in str(f.get("id_perfil_video", ""))),
+        ("videos_vistos", lambda f: "tears" not in str(f.get("id_perfil_video", ""))),
+        ("oboe", lambda f: str(f.get("id_dataset", "")).startswith("oboe")),
+        ("fcc", lambda f: str(f.get("id_dataset", "")).startswith("fcc")),
+    ):
+        estratos[nombre] = {
+            rival: {
+                metrica: contraste(diferencias_por_ventana(resumenes, referencia, rival, metrica, filtro), "bilateral")
+                for metrica in ("qoe_lineal_media", "num_stalls")
+            }
+            for rival in ("mpc_robusto", "propio_cuantiles_recientes")
+            if rival in alias
+        }
+    return {"hipotesis": hipotesis, "principales": principales, "secundarias": secundarias, "estratos": estratos,
+            "contenido_nuevo_frente_a_visto": _interaccion_contenido(resumenes, referencia)}
+
+
+def _interaccion_contenido(resumenes: Sequence[Mapping[str, Any]], referencia: str) -> Dict[str, Any]:
+    # En cada ventana: (propio - MPC) con el video nuevo menos (propio - MPC) con el visto.
+    nuevo = diferencias_por_ventana(resumenes, referencia, "mpc_robusto", "qoe_lineal_media",
+                                    lambda f: "tears" in str(f.get("id_perfil_video", "")))
+    visto = diferencias_por_ventana(resumenes, referencia, "mpc_robusto", "qoe_lineal_media",
+                                    lambda f: "tears" not in str(f.get("id_perfil_video", "")))
+    pares = {v: [nuevo[v][0] - visto[v][0]] for v in nuevo if v in visto and nuevo[v] and visto[v]}
+    return contraste(pares, "bilateral") if pares else {"n_ventanas": 0}
+
+
+def _cola_binomial(n: int, k: int) -> float:
+    # P(X <= k) con X ~ Binomial(n, 1/2): prueba del signo exacta unilateral.
+    if n <= 0:
+        return 1.0
+    return min(1.0, sum(math.comb(n, i) for i in range(0, k + 1)) / float(2 ** n))
+
+
+def _normal(x: float) -> float:
+    return 0.5 * (1.0 + math.erf(x / math.sqrt(2.0)))
+
+
+def _float(valor: Any) -> float:
+    try:
+        return float(valor)
+    except (TypeError, ValueError):
+        return 0.0
+
+
+def _int(valor: Any) -> int:
+    try:
+        return int(float(valor))
+    except (TypeError, ValueError):
+        return 0
+
+
+def _bool(valor: Any) -> bool:
+    if isinstance(valor, bool):
+        return valor
+    return str(valor).strip().lower() in {"1", "true", "si", "yes"}
