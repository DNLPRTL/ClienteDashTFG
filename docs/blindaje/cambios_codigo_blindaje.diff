+"""El modelo se carga al crear el controlador propio, y si falla decide el respaldo."""
+from __future__ import annotations
+
+import tempfile
+import unittest
+
+from artefactos import DIR_BUNDLE, RUTA_CUANTILES_FIJOS  # noqa: E402  (anade el codigo al path)
+
+from core.controladores.registro import crear_controlador  # noqa: E402
+from core.feedback_reproductor import construir_realimentacion_controlador  # noqa: E402
+from core.modelo_propio.perfil_video import PerfilTamanosSegmentos  # noqa: E402
+
+
+def _realimentacion(indice, tasas):
+    return construir_realimentacion_controlador(
+        bytes_en_cola=0, tiempo_en_cola=4.0 * indice, tasas=tasas, duraciones_fragmentos=[4.0] * len(tasas),
+        nivel_actual=0, nivel_max=len(tasas) - 1, bytes_descargados=0, indice_segmento=indice,
+        inicio_peticion_segmento=None, fin_peticion_segmento=None, ultimo_tamano=150_000,
+        ultimo_tiempo=0.4, duracion_fragmento=4.0, segmentos_totales=31)
+
+
+class TestCargaModelo(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        perfil = PerfilTamanosSegmentos.cargar_por_id("paseo_almunecar_10min_30fps_4s")
+        cls.tasas = [b / 8.0 for b in perfil.bitrates_bps]
+
+    @unittest.skipIf(DIR_BUNDLE is None or RUTA_CUANTILES_FIJOS is None, "faltan el bundle o los cuantiles fijos")
+    def test_el_modelo_se_carga_al_crear_el_controlador(self):
+        for clave in ("controlador_propio", "propio_mediana", "propio_cuantiles_recientes", "propio_cuantiles_fijos"):
+            parametros = {"dir_bundle": DIR_BUNDLE, "id_perfil_video": "paseo_10min_30fps_4s", "alfa_riesgo": 0.75}
+            if clave == "propio_cuantiles_fijos":
+                parametros["ruta_cuantiles_fijos"] = RUTA_CUANTILES_FIJOS
+            controlador = crear_controlador(clave, parametros)
+            self.assertIsNotNone(controlador._bundle, clave)
+            if clave == "propio_cuantiles_fijos":
+                self.assertIsNotNone(controlador._cuantiles_fijos)
+
+    def test_si_falla_la_carga_decide_el_respaldo(self):
+        with tempfile.TemporaryDirectory() as vacio:
+            controlador = crear_controlador(
+                "controlador_propio", {"dir_bundle": vacio, "id_perfil_video": "paseo_10min_30fps_4s"}
+            )
+            self.assertIsNone(controlador._bundle)
+            for indice in (1, 2):
+                controlador.fijarFeedbackReproductor(_realimentacion(indice, self.tasas))
+            tasa = controlador.calcularAccionControl()
+        diagnosticos = controlador.obtener_diagnosticos_red()
+        self.assertEqual(diagnosticos["respaldo_red_usado"], 1)
+        self.assertEqual(diagnosticos["motivo_respaldo_red"], "fallo_carga_bundle")
+        self.assertIn(tasa, self.tasas)
+
+
+if __name__ == "__main__":
+    unittest.main()
