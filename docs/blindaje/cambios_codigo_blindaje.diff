+def cargar_cuantiles_fijos(ruta: str, cuantiles: Sequence[float], horizonte: int) -> np.ndarray:
+    with open(ruta, encoding="utf-8") as fichero:
+        datos = json.load(fichero)
+    if datos.get("id_esquema") != "cuantiles_fijos_log_ratio_v1":
+        raise ErrorBundle("id_esquema de los cuantiles fijos inesperado")
+    if [round(float(q), 6) for q in datos["cuantiles"]] != [round(float(q), 6) for q in cuantiles]:
+        raise ErrorBundle("los cuantiles fijos no son los del modelo")
+    valores = np.asarray(datos["valores_log_ratio_por_horizonte_y_cuantil"], dtype=np.float64)
+    if valores.shape != (int(horizonte), len(cuantiles)) or not np.all(np.isfinite(valores)):
+        raise ErrorBundle("la tabla de cuantiles fijos tiene forma invalida")
+    return valores
