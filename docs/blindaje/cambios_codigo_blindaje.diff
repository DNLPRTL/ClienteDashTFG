+        )
+    )
+    lineas += ["", "## Hipotesis principales", "",
+               "| Id | Hipotesis | Media dif. | IC95 | IC90 | Ventanas +/-/= | p | p Holm | Se acepta |",
+               "|---|---|---|---|---|---|---|---|---|"]
+    for clave, h in sorted(_mapa(contrastes.get("principales")).items()):
+        aceptada = bool(h.get("rechazada_nula"))
+        if h.get("tipo") == "equivalencia":
+            aceptada = aceptada and bool(h.get("equivalente_ic90"))
+        lineas.append(
+            "| {0} | {1} | {2:+.3f} | [{3:+.3f}; {4:+.3f}] | [{5:+.3f}; {6:+.3f}] | {7}/{8}/{9} | {10:.4f} | {11:.4f} | {12} |".format(
+                clave, h.get("texto", ""), _float(h.get("media_diferencia")), _float(h["ic95"][0]), _float(h["ic95"][1]),
+                _float(h["ic90"][0]), _float(h["ic90"][1]), h.get("ventanas_positivas", 0), h.get("ventanas_negativas", 0),
+                h.get("ventanas_empate", 0), _float(h.get("p_valor"), 1.0), _float(h.get("p_holm"), 1.0),
+                "si" if aceptada else "no",
