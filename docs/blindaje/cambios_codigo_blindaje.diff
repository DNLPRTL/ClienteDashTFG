@@ -0,0 +1,103 @@
+from __future__ import annotations
+
+import math
+from collections.abc import Mapping, Sequence
+from numbers import Real
+
+from core.modelo_propio.estado_sesion import EstadoSesion
+from core.modelo_propio.perfil_video import PerfilTamanosSegmentos
+
+# Estado de la sesion y escalera con los tamanos reales del video activo, comunes a los
+# controladores que deciden con el planificador de core/modelo_propio/planificador.py (el propio
+# y el MPC), para que todos planifiquen sobre la misma informacion.
+
+
+def flotante_finito(valor: object) -> float | None:
+    if isinstance(valor, bool) or not isinstance(valor, Real):
+        return None
+    convertido = float(valor)
+    if not math.isfinite(convertido):
+        return None
+    return convertido
+
+
+def entero_positivo(valor: object, por_defecto: int, *, permitir_cero: bool = False) -> int:
+    try:
+        convertido = int(valor)
+    except (TypeError, ValueError):
+        return int(por_defecto)
+    if convertido < 0 or (convertido == 0 and not permitir_cero):
+        return int(por_defecto)
+    return int(convertido)
+
+
+def historial_positivo(valores: object) -> tuple[float, ...]:
+    if not isinstance(valores, (list, tuple)):
+        return ()
+    positivos = []
+    for valor in valores:
+        numero = flotante_finito(valor)
+        if numero is not None and numero > 0.0:
+            positivos.append(float(numero))
+    return tuple(positivos)
+
+
+def segmentos_video_sesion(feedback: Mapping[str, object]) -> int:
+    # segmentos_totales del reproductor incluye el segmento de inicializacion.
+    return max(entero_positivo(feedback.get("segmentos_totales"), 31) - 1, 1)
+
+
+def estado_desde_carga(
+    entradas_contexto: Mapping[str, object],
+    tasas_Bps: Sequence[float],
+    feedback: Mapping[str, object],
+) -> EstadoSesion:
+    # Como en el entrenamiento: el indice es el del siguiente segmento de video a descargar y la
+    # sesion tiene segmentos_totales - 1 segmentos. La ultima decision de la sesion no tiene
+    # segmento siguiente y se acota al ultimo.
+    segmentos_video = segmentos_video_sesion(feedback)
+    indice_segmento = min(
+        max(entero_positivo(feedback.get("indice_segmento"), 0, permitir_cero=True), 0),
+        segmentos_video - 1,
+    )
+    nivel = entero_positivo(feedback.get("nivel"), 0, permitir_cero=True)
+    indice_ultima_representacion = min(max(nivel, 0), max(len(tasas_Bps) - 1, 0))
+    return EstadoSesion(
+        indice_segmento=indice_segmento,
+        buffer_s=float(entradas_contexto.get("buffer_s", 0.0) or 0.0),
+        indice_ultima_representacion=indice_ultima_representacion,
+        historial_throughput_bps=historial_positivo(entradas_contexto.get("historial_throughput_bps")),
+        historial_tiempo_descarga_s=historial_positivo(entradas_contexto.get("historial_tiempo_descarga_s")),
+        rebuffering_reciente_s=float(entradas_contexto.get("rebuffering_reciente_s", 0.0) or 0.0),
+        cambio_reciente_abs=float(entradas_contexto.get("cambio_reciente_abs", 0.0) or 0.0),
+        tiempo_red_s=0.0,
+        segmentos_totales=segmentos_video,
+    )
+
+
+def cargar_escalera_sesion(
+    id_perfil_video: str,
+    *,
+    dir_perfiles_video: str | None,
+    buffer_maximo_s: float,
+    num_segmentos: int,
+):
+    # La escalera abarca los segmentos de la sesion, como en el entrenamiento; los tamanos son
+    # los reales del video desde su primer segmento.
+    perfil = PerfilTamanosSegmentos.cargar_por_id(id_perfil_video, dir_base=dir_perfiles_video)
+    return perfil.a_escalera_fiel(buffer_maximo_s=buffer_maximo_s, num_segmentos=num_segmentos)
+
+
+def diferencia_escalera(escalera, tasas_Bps: Sequence[float]) -> str:
+    # Texto vacio si la escalera del descriptor coincide con las tasas del MPD del cliente.
+    tasas = tuple(float(valor) for valor in tasas_Bps)
+    if escalera.num_representaciones != len(tasas):
+        return "la escalera del video ({0} niveles) no coincide con las tasas del cliente ({1})".format(
+            escalera.num_representaciones, len(tasas)
+        )
+    for indice, tasa_Bps in enumerate(tasas):
+        if abs(tasa_Bps * 8.0 - float(escalera.bitrate_bps(indice))) > 8.0:
+            return "bitrate de la escalera del video distinto en el indice {0}: {1} vs {2}".format(
+                indice, tasa_Bps * 8.0, escalera.bitrate_bps(indice)
+            )
+    return ""
