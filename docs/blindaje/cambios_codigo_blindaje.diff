diff -ruN '--exclude=__pycache__' '--exclude=.idea' TFG/legacy/codigo_entrega_20261014_antes_blindaje/ClienteDashTFG/scripts/2_entrenamiento/calcular_cuantiles_fijos.py "TFG Material/01_codigo/ClienteDashTFG/scripts/2_entrenamiento/calcular_cuantiles_fijos.py"
--- TFG/legacy/codigo_entrega_20261014_antes_blindaje/ClienteDashTFG/scripts/2_entrenamiento/calcular_cuantiles_fijos.py	1970-01-01 01:00:00.000000000 +0100
+++ "TFG Material/01_codigo/ClienteDashTFG/scripts/2_entrenamiento/calcular_cuantiles_fijos.py"	2026-10-14 19:00:42.903168400 +0200
@@ -0,0 +1,81 @@
+"""Cuantiles fijos del error de la media armonica, para la variante sin red del controlador propio.
+
+La red predice, para cada horizonte h y cuantil tau, log(throughput futuro / media armonica de
+las ultimas descargas). La variante sin red usa en su lugar el cuantil empirico de esa misma
+etiqueta en el dataset de entrenamiento: es el predictor constante que minimiza la perdida
+pinball, el mismo espacio de salida sin condicionar al estado. Solo cuentan las muestras con
+historial no vacio, porque el controlador nunca decide sin descargas previas.
+
+Uso:
+  python scripts/2_entrenamiento/calcular_cuantiles_fijos.py --dataset datos_entrenamiento.jsonl --salida cuantiles_fijos.json
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import math
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+import numpy as np
+
+ID_ESQUEMA = "cuantiles_fijos_log_ratio_v1"
+
+
+def sha256_fichero(ruta: Path) -> str:
+    resumen = hashlib.sha256()
+    with ruta.open("rb") as fichero:
+        for bloque in iter(lambda: fichero.read(1 << 20), b""):
+            resumen.update(bloque)
+    return resumen.hexdigest()
+
+
+def main(argv=None) -> int:
+    args = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    args.add_argument("--dataset", type=Path, required=True)
+    args.add_argument("--salida", type=Path, required=True)
+    opciones = args.parse_args(argv)
+
+    etiquetas = []
+    cuantiles = horizonte = None
+    descartadas = 0
+    with opciones.dataset.open(encoding="utf-8") as fichero:
+        for linea in fichero:
+            muestra = json.loads(linea)
+            historial = muestra["entradas_modelo"]["contexto"]["historial_throughput_bps"]
+            if not any(float(v) > 0.0 for v in historial):
+                descartadas += 1
+                continue
+            objetivos = muestra["objetivos_cuantiles_throughput"]
+            cuantiles = cuantiles or [float(q) for q in objetivos["cuantiles"]]
+            horizonte = horizonte or int(objetivos["horizonte_segmentos"])
+            etiquetas.append([float(v) for v in objetivos["log_ratio_objetivo_por_horizonte"]])
+    matriz = np.asarray(etiquetas, dtype=np.float64)
+    if matriz.ndim != 2 or matriz.shape[1] != horizonte or not np.all(np.isfinite(matriz)):
+        print("etiquetas invalidas", file=sys.stderr)
+        return 1
+    valores = [[float(np.quantile(matriz[:, h], q)) for q in cuantiles] for h in range(horizonte)]
+    salida = {
+        "id_esquema": ID_ESQUEMA,
+        "descripcion": "cuantil empirico de log(throughput futuro / media armonica) por horizonte",
+        "cuantiles": cuantiles,
+        "horizonte_segmentos": horizonte,
+        "valores_log_ratio_por_horizonte_y_cuantil": valores,
+        "num_muestras": int(matriz.shape[0]),
+        "num_muestras_sin_historial_descartadas": int(descartadas),
+        "dataset": opciones.dataset.name,
+        "sha256_dataset": sha256_fichero(opciones.dataset),
+        "generado": datetime.now(timezone.utc).isoformat(),
+    }
+    opciones.salida.parent.mkdir(parents=True, exist_ok=True)
+    opciones.salida.write_text(json.dumps(salida, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print("CUANTILES_FIJOS muestras={0} descartadas={1}".format(matriz.shape[0], descartadas))
+    for h, fila in enumerate(valores, start=1):
+        print("  h={0}: {1}".format(h, " ".join("{0:+.4f} (x{1:.3f})".format(v, math.exp(v)) for v in fila)))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
