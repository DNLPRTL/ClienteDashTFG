+        inicio_ventana_s=float(inicio_s),
+        duracion_ventana_s=float(duracion_s),
+    )
+    total_s = sum(muestra.duracion_s for muestra in traza.muestras)
+    media = sum(muestra.throughput_kbps * muestra.duracion_s for muestra in traza.muestras) / total_s
+    return {
+        "throughput_medio_ventana_kbps": round(float(media), 3),
+        "throughput_min_ventana_kbps": round(float(min(m.throughput_kbps for m in traza.muestras)), 3),
