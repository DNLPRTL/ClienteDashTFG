+                "la escalera del video ({0} niveles) no coincide con las tasas del cliente ({1})".format(
+                    self._escalera.num_representaciones, len(tasas)
+                )
+            )
+
+        for indice, tasa_Bps in enumerate(tasas):
+            if abs(tasa_Bps * 8.0 - float(self._escalera.bitrate_bps(indice))) > 8.0:
+                raise ErrorBundle(
+                    "bitrate de la escalera del video distinto en el indice {0}: {1} vs {2}".format(
+                        indice, tasa_Bps * 8.0, self._escalera.bitrate_bps(indice)
+                    )
+                )
+        return self._escalera
+
+    def _decidir_por_respaldo(self, motivo: str, diagnosticos: DiagnosticosRed, carga) -> float:
+        diagnosticos.respaldo_usado = 1
+        diagnosticos.motivo_respaldo = motivo_estable(motivo)
+        if carga is not None:
+            diagnosticos.num_acciones_validas = carga.num_acciones_validas
+        try:
+            tasa = float(self.controlador_respaldo.calcularAccionControl())
+            if carga is not None:
+                accion = cuantizar_tasa_a_nivel(tasa, carga.tasas_Bps)
+                if accion < len(carga.mascara_acciones) and carga.mascara_acciones[accion]:
+                    tasa = float(carga.tasas_Bps[accion])
+                else:
+                    accion, tasa = _menor_tasa_valida(carga)
+            else:
+                accion = self.cuantizarTasa(tasa)
+        except Exception:
+            accion, tasa = _menor_tasa_valida(carga)
+        diagnosticos.accion_segura = "" if accion is None else str(accion)
+        diagnosticos.tasa_segura_Bps = str(float(tasa))
+        diagnosticos.indice_representacion_elegida = diagnosticos.accion_segura
+        diagnosticos.accion_valida = 1 if accion is not None else 0
+        self._registrar_decision(float(tasa), diagnosticos)
+        return float(tasa)
+
+    def _registrar_decision(self, tasa: float, diagnosticos: DiagnosticosRed) -> None:
+        self.fijarDuracionInactividad(0.0)
+        self.fijarAccionControl(float(tasa))
+        self._diagnosticos = diagnosticos
+        self.ultimas_metricas = diagnosticos.a_campos_realimentacion()
+
+    def _diagnosticos_base(self) -> DiagnosticosRed:
+        return DiagnosticosRed(
+            clave_controlador=self.clave_controlador,
+            etiqueta_modelo=ETIQUETAS_POR_MODO[self.modo_prediccion],
+            ruta_bundle=self.dir_bundle,
+            bundle_configurado=1 if self.dir_bundle.strip() else 0,
+            solo_diagnostico=1 if self.solo_diagnostico else 0,
+        )
+
