+@dataclass(frozen=True)
+class ReglaReescrituraRuta:
+    prefijo_origen: str
+    prefijo_objetivo: str
+
+    def aplicar(self, valor: str) -> str:
+        origen = self.prefijo_origen.rstrip("/\\")
+        objetivo = self.prefijo_objetivo.rstrip("/\\")
+        texto = str(valor)
+        if texto == origen:
+            return objetivo
+        if texto.startswith(origen + "/") or texto.startswith(origen + "\\"):
+            sufijo = texto[len(origen) :].lstrip("/\\")
+            return str(Path(objetivo) / Path(*sufijo.replace("\\", "/").split("/")))
+        return texto
+
+    def a_json(self) -> dict[str, object]:
+        return {"prefijo_origen": self.prefijo_origen, "prefijo_objetivo": self.prefijo_objetivo}
