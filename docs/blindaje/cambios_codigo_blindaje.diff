+
+
+def parsear_regla_reescritura(valor: str) -> ReglaReescrituraRuta:
+    if "=" not in str(valor):
+        raise ErrorRutasTrazas("la reescritura de rutas debe tener formato VIEJO=NUEVO")
+    origen, objetivo = str(valor).split("=", 1)
+    origen = origen.strip()
+    objetivo = objetivo.strip()
+    if not origen or not objetivo:
+        raise ErrorRutasTrazas("VIEJO y NUEVO de la reescritura no pueden estar vacios")
+    return ReglaReescrituraRuta(prefijo_origen=origen, prefijo_objetivo=str(Path(objetivo).expanduser()))
+
+
+def parsear_reglas_reescritura(valores: Iterable[str]) -> tuple[ReglaReescrituraRuta, ...]:
+    return tuple(parsear_regla_reescritura(valor) for valor in valores)
+
+
+def resolver_ruta_traza_externa(ruta_bruta: object, reglas: Sequence[ReglaReescrituraRuta]) -> Path:
+    texto = str(ruta_bruta)
+    reescrita = texto
+    for regla in reglas:
+        siguiente = regla.aplicar(reescrita)
+        if siguiente != reescrita:
+            reescrita = siguiente
+            break
+    return Path(reescrita).expanduser()
