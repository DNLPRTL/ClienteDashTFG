+"""Rutas del codigo y de los artefactos que usan las pruebas, en Windows y en la VM."""
+from __future__ import annotations
+
+import os
+import sys
+from pathlib import Path
+
+RAIZ_CODIGO = Path(__file__).resolve().parents[1]
+if str(RAIZ_CODIGO) not in sys.path:
+    sys.path.insert(0, str(RAIZ_CODIGO))
+
+
+def _primera_existente(*rutas):
+    for ruta in rutas:
+        if ruta and Path(ruta).exists():
+            return str(ruta)
+    return None
+
+
+# Windows: TFG Material\01_codigo\ClienteDashTFG y TFG Material\03_modelos.
+# VM: ~/TFG/ClienteDashTFG y ~/TFG/modelos.
+DIR_BUNDLE = _primera_existente(
+    os.environ.get("TFG_BUNDLE"),
+    RAIZ_CODIGO.parents[1] / "03_modelos" / "modelo_propio" / "bundle",
+    RAIZ_CODIGO.parent / "modelos" / "modelo_propio" / "bundle",
+)
+RUTA_CUANTILES_FIJOS = _primera_existente(
+    os.environ.get("TFG_CUANTILES_FIJOS"),
+    RAIZ_CODIGO.parents[1] / "03_modelos" / "cuantiles_fijos" / "cuantiles_fijos.json",
